# ---- Core ----
CLIP_WORKSPACE=./workspace
CLIP_FFMPEG_BIN=ffmpeg
CLIP_FFPROBE_BIN=ffprobe
CLIP_DB_PATH=./workspace/ledger.sqlite3

# ---- Claude (hooks, moment selection, captions QA) ----
ANTHROPIC_API_KEY=
CLIP_CLAUDE_MODEL=claude-opus-5-5
CLIP_CLAUDE_EFFORT=medium

# ---- Captions (faster-whisper) ----
CLIP_WHISPER_MODEL=small
CLIP_WHISPER_DEVICE=cuda       # cuda on your 4070, cpu fallback
CLIP_WHISPER_COMPUTE=float16   # int8 for cpu

# ---- YouTube Data API v3 (Shorts upload) ----
# Download OAuth "Desktop app" client JSON from Google Cloud Console -> APIs & Services -> Credentials
CLIP_YT_CLIENT_SECRETS=./secrets/yt_client_secret.json
CLIP_YT_TOKEN_PATH=./secrets/yt_token.json

# ---- Instagram Graph API (Reels publish; needs Creator/Business IG linked to a Facebook Page) ----
CLIP_IG_USER_ID=
CLIP_IG_ACCESS_TOKEN=
# Reels publish needs a PUBLIC https URL to the mp4. Point at your R2/S3 bucket public base URL.
CLIP_PUBLIC_MEDIA_BASE_URL=
CLIP_PUBLIC_MEDIA_DIR=

# ---- TikTok Content Posting API (direct post requires an audited app; otherwise mode=manual) ----
CLIP_TIKTOK_ACCESS_TOKEN=
CLIP_TIKTOK_MODE=manual         # manual | api

# ---- PayPal REST (Transaction Search needs the "Transaction Search" permission on the app) ----
CLIP_PAYPAL_CLIENT_ID=
CLIP_PAYPAL_CLIENT_SECRET=
CLIP_PAYPAL_ENV=live            # live | sandbox
